{
  "name": "@gepetta/desktop",
  "productName": "Gepetta Studio",
  "version": "0.3.1",
  "private": true,
  "description": "Estudio de animación stop-motion y cuadro a cuadro",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:main": "node build.mjs",
    "dev": "concurrently -k -n web,app -c yellow,cyan \"pnpm --filter @gepetta/studio dev\" \"pnpm --filter @gepetta/phone build && wait-on tcp:127.0.0.1:5173 && node build.mjs && cross-env GEPETTA_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm --filter @gepetta/studio build && pnpm --filter @gepetta/phone build && node build.mjs && node copy-renderer.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "test": "vitest run",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "release:win": "pnpm build && electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "@gepetta/core": "workspace:*",
    "@gepetta/protocol": "workspace:*",
    "@types/node": "22.20.5",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.5",
    "cross-env": "10.1.0",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "electron-updater": "6.8.10",
    "esbuild": "0.25.12",
    "jpeg-js": "0.4.4",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wait-on": "8.0.5",
    "ws": "8.18.3"
  },
  "build": {
    "appId": "com.gepetta.studio",
    "productName": "Gepetta Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "renderer/**",
      "phone/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Gepetta Studio usa la cámara para sacar las fotos de tu animación.",
        "NSMicrophoneUsageDescription": "Gepetta Studio puede grabar sonido para tu animación."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jlurgo",
        "repo": "gepetta-studio",
        "releaseType": "release"
      }
    ]
  }
}
